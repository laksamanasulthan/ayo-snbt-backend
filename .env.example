# ── Server ──────────────────────────────────────────────
NODE_ENV=development
# True behind HAProxy (X-Forwarded-For trusted for rate limiting + audit)
TRUST_PROXY=false
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ── Database (PostgreSQL 18 via PgBouncer) ───────────────
# DATABASE_URL points at PgBouncer (transaction pooling).
# DIRECT_DATABASE_URL bypasses PgBouncer (migrations only).
DATABASE_URL=postgres://ayosnbt:ayosnbt@localhost:6432/ayosnbt
# Note: docker postgres is published on 5433 to avoid clashing with host postgres on 5432
DIRECT_DATABASE_URL=postgres://ayosnbt:ayosnbt@localhost:5433/ayosnbt
# Optional: point reads at a replica (falls back to primary when unset)
DATABASE_URL_REPLICA=
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAXMEMORY_MB=256
QUEUE_PREFIX=ayosnbt

# ── MongoDB (chat) ───────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/ayosnbt_chat

# ── S3 (MinIO in dev; AWS/R2/Spaces in prod) ─────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_IMAGES=ayosnbt-images
S3_BUCKET_VIDEOS=ayosnbt-videos
S3_PRESIGN_TTL_SECONDS=120

# ── Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CSRF_ENABLED=true

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ayo-SNBT <no-reply@ayo-snbt.id>"
SMTP_SECURE=false

# ── OAuth2 (Google social login) ─────────────────────────
OAUTH_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth2/google/callback
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:5173

# ── API docs (Scalar) ────────────────────────────────────
DOCS_ENABLED=true

# Frontend origin used in email template links (verify/reset)
FRONTEND_URL=http://localhost:5173

# ── Rate limiting defaults ───────────────────────────────
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Payments ────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
PAYMENT_BASE_URL=http://localhost:3000