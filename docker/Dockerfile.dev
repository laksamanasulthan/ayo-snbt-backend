# Dev image (compose.dev.yml only) — full dev dependencies + tsx watch.
# Gives Docker mode HOT RELOAD: source is bind-mounted into the container and
# tsx restarts on every save. Production always uses the multi-stage Dockerfile
# (built dist, no dev deps).
FROM node:22-alpine
WORKDIR /app
# npm ci runs BEFORE .npmrc is copied in, so ignore-scripts=true does NOT
# skip native installs (ffmpeg-static, @node-rs/argon2 prebuilts).
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Polling watcher (fs.watch events don't cross Docker Desktop bind mounts)
CMD ["node", "scripts/dev.mjs", "src/server.ts"]
