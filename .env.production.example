# Production environment — copy to .env.production on the VPS (never commit)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
COOKIE_SECURE=true
CSRF_ENABLED=true

# Generated on first deploy; keep in a secrets manager
JWT_ACCESS_SECRET=replace-with-64-random-chars
REFRESH_TOKEN_TTL_DAYS=30

DATABASE_URL=postgres://ayosnbt:CHANGE_ME@pgbouncer:6432/ayosnbt
DIRECT_DATABASE_URL=postgres://ayosnbt:CHANGE_ME@postgres:5432/ayosnbt
# DATABASE_URL_REPLICA=postgres://ayosnbt:CHANGE_ME@postgres-replica:5432/ayosnbt
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongo:27017/ayosnbt_chat
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=no-reply@ayo-snbt.id
SMTP_PASS=CHANGE_ME
SMTP_FROM="Ayo-SNBT <no-reply@ayo-snbt.id>"
SMTP_SECURE=false

PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMENT_BASE_URL=https://api.ayo-snbt.id

OAUTH_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=https://api.ayo-snbt.id/auth/oauth2/google/callback
OAUTH_FRONTEND_REDIRECT_URL=https://ayo-snbt.id

DOCS_ENABLED=false
CORS_ORIGIN=https://ayo-snbt.id
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000